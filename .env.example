HTTP_ADDRESS=:8081
CONTRACT_MYSQL_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
CONTRACT_MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
MYSQL_DSN='contract:contract@tcp(localhost:3306)/contract_management?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci'

# Keycloak Client 配置。Issuer 必须包含 realm，不能只填写 Keycloak 服务器根地址。
PLATFORM_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=contract_management-dev-web
OIDC_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:8081/contract_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=REPLACE_WITH_PLATFORM_TENANT_ID
OIDC_SESSION_COOKIE_NAME=contract_management_session
OIDC_SESSION_COOKIE_SECURE=false
OIDC_SESSION_TTL=8h
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
OIDC_AUTHORIZATION_CONTEXT_TIMEOUT=10s
OIDC_AUTHORIZATION_MAX_STALE=2m
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

APP_PUBLIC_URL=http://localhost:8081/contract_management/
APP_PATH_PREFIX=/contract_management

# 审计上报仅使用单独的 service OAuth Client；不复用浏览器 OIDC Client。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=dev

# 应用自有权限目录发布凭据；由“一键接入”生成，不能与浏览器或审计 Client 共用。
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
# 合同审批人员目录机器客户端，仅授予 owner_directory.read；未配置时审批规则安全失败关闭。
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE='0 16 * * *'

# 数据看板系统（服务器到服务器）机器接入：internal/v1/dashboard 只读接口。
DASHBOARD_MACHINE_ENABLED=false
DASHBOARD_MACHINE_REQUIRE_BEARER=false
DASHBOARD_MACHINE_CLIENT_ID=
DASHBOARD_MACHINE_AUDIENCE=

# 合同生效后通过受控内部网络可靠投递至项目管理。
PROJECT_INTEGRATION_ENABLED=false
PROJECT_API_BASE_URL=http://localhost:8082
PROJECT_INTEGRATION_POLL_INTERVAL=2s
PROJECT_INTEGRATION_MAX_ATTEMPTS=20

# 子系统 API 容器加入的平台 Docker 网络。
PLATFORM_DOCKER_NETWORK=basic-platform-local_default
