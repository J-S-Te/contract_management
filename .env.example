HTTP_ADDRESS=:8081
MYSQL_DSN='contract:contract@tcp(localhost:3306)/contract_management?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci'
# 容器接入 platform Compose 时使用 http://api:8080；宿主机直跑时使用 localhost。
PLATFORM_BASE_URL=http://localhost:8080
AUTH_SESSION_COOKIE_NAME=bp_session
# 审计接入仅使用机器 OAuth Client Credentials；四项均配置后才启用。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=dev
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE='0 16 * * *'
APPROVER_ROLE_ASSIGNMENTS_JSON='{"sales_director":["01J00000000000000000000001"],"technical_director":["01J00000000000000000000002"],"finance_director":["01J00000000000000000000003"],"administrator":["01J00000000000000000000004"]}'
