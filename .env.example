HTTP_ADDRESS=:8081
# 分体键（SEC-N10/SEC-N10c）：compose 用 CONTRACT_MYSQL_PASSWORD 拼装容器内 DSN，
# docker-local.sh 生成 .env.local 时会随机改写这两个口令。
CONTRACT_MYSQL_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
CONTRACT_MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
# 拼接式明文 DSN 已移除：模板不再内联口令（SEC-N10c）。
#   - 容器运行：DSN 由 compose 用上面分体键拼装后经 environment 注入
#     （environment 优先级高于 env_file，容器不会读到本键的宿主值）；
#   - 宿主直连：按下面分体键自行拼装，形如
#     user:password@tcp(host:port)/db?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
MYSQL_DSN=
MYSQL_USER=contract
MYSQL_HOST=127.0.0.1:3306
MYSQL_DATABASE=contract_management

# Keycloak Client 配置。Issuer 必须包含 realm，不能只填写 Keycloak 服务器根地址。
PLATFORM_BASE_URL=http://localhost:8081
OIDC_ISSUER=http://localhost:18090/realms/basic-platform
OIDC_BACKCHANNEL_BASE_URL=
OIDC_CLIENT_ID=contract_management-dev-web
OIDC_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:8081/contract_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile
OIDC_TENANT_ID=REPLACE_WITH_PLATFORM_TENANT_ID
OIDC_SESSION_COOKIE_NAME=contract_management_session
OIDC_SESSION_COOKIE_SECURE=false
OIDC_SESSION_TTL=8h
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
OIDC_AUTHORIZATION_CONTEXT_TIMEOUT=10s
OIDC_AUTHORIZATION_MAX_STALE=2m
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

APP_PUBLIC_URL=http://localhost:8081/contract_management/
APP_PATH_PREFIX=/contract_management

# 审计上报仅使用单独的 service OAuth Client；不复用浏览器 OIDC Client。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
# prod 默认要求审计可用并在 /readyz 缺配时返回 503；开发环境可显式设 false。
PLATFORM_AUDIT_REQUIRED=false
PLATFORM_APPLICATION_CODE=contract_management
PLATFORM_ENVIRONMENT_CODE=dev

# 应用自有权限目录发布凭据；由“一键接入”生成，不能与浏览器或审计 Client 共用。
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=false
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=
# 合同审批人员目录机器客户端，仅授予 owner_directory.read；未配置时审批规则安全失败关闭。
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=
# 站内信上送机器客户端，仅授予 notification.ingest；未配置时不投递平台站内信。
PLATFORM_NOTIFICATION_CLIENT_ID=
PLATFORM_NOTIFICATION_CLIENT_SECRET=

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=contract-management
TEMPORAL_TLS=false
APPROVAL_NODE_TIMEOUT=72h
APPROVAL_REMINDER_INTERVAL=24h
ARCHIVE_CRON_SCHEDULE='0 16 * * *'

# 数据看板系统（服务器到服务器）机器接入：internal/v1/dashboard 只读接口。
# 使用上面的 OIDC_ISSUER + OIDC_BACKCHANNEL_BASE_URL 做 Keycloak Discovery/JWKS 验签；
# 不配置 CONTRACT_MACHINE_TOKEN_ISSUER，也不使用平台 Ed25519 公钥。
# 令牌必须满足 azp/client_id=DASHBOARD_MACHINE_CLIENT_ID、aud 包含 DASHBOARD_MACHINE_AUDIENCE。
DASHBOARD_MACHINE_ENABLED=false
DASHBOARD_MACHINE_REQUIRE_BEARER=false
DASHBOARD_MACHINE_CLIENT_ID=data_analysis-dev-machine
DASHBOARD_MACHINE_AUDIENCE=basic-platform-application

# CRM 按商机读取已签合同数量的机器接口。
CRM_SIGNED_COUNT_MACHINE_ENABLED=false
CRM_SIGNED_COUNT_MACHINE_REQUIRE_BEARER=false
CRM_SIGNED_COUNT_MACHINE_ISSUER=basic-platform
CRM_SIGNED_COUNT_MACHINE_AUDIENCE=basic-platform-application
CRM_SIGNED_COUNT_MACHINE_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CRM_SIGNED_COUNT_MACHINE_CLIENT_ID=customer_and_opportunity-dev-contract-signed-count
CRM_SIGNED_COUNT_MACHINE_CALLER_APPLICATION_CODE=customer_and_opportunity
CRM_SIGNED_COUNT_MACHINE_CALLER_ENVIRONMENT_CODE=dev
CRM_SIGNED_COUNT_MACHINE_REQUIRED_SCOPE=contract.opportunity_signed_count.read

# 合同生效后通过受控内部网络可靠投递至项目管理。
PROJECT_INTEGRATION_ENABLED=false
PROJECT_API_BASE_URL=http://localhost:8082
PROJECT_INTEGRATION_POLL_INTERVAL=2s
PROJECT_INTEGRATION_MAX_ATTEMPTS=20
PROJECT_INTEGRATION_TOKEN_URL=http://localhost:8080/oauth2/token
PROJECT_INTEGRATION_CLIENT_ID=
PROJECT_INTEGRATION_CLIENT_SECRET=
PROJECT_INTEGRATION_AUDIENCE=basic-platform-application

# 外部合同创建前使用独立最小权限机器身份复核 CRM 客户/商机；生产必须启用。
CRM_REFERENCE_ENABLED=false
CRM_REFERENCE_BASE_URL=http://localhost:8090
CRM_REFERENCE_TOKEN_URL=http://localhost:8080/oauth2/token
CRM_REFERENCE_CLIENT_ID=
CRM_REFERENCE_CLIENT_SECRET=
CRM_REFERENCE_SCOPE=customer.contract_reference.read

# 子系统 API 容器加入的平台 Docker 网络。
PLATFORM_DOCKER_NETWORK=basic-platform-local_default

# --- 以下为 SEC-N10c 补齐：配置读取但模板此前缺失的键 ---
# 约定：留空 = 与键不存在时的运行时默认行为一致（env() 空值回退代码默认）。

# 站内信/商机链接的 CRM 通道（与 CRM_REFERENCE_* 同源；仅在启用分发时填写）
CRM_API_BASE_URL=
CRM_API_TOKEN=

# 统一文件网关（STAMPED_FILE_GATEWAY_MODE=legacy 时无需填写其余键）
STAMPED_FILE_GATEWAY_MODE=legacy
FILE_GATEWAY_BASE_URL=
FILE_GATEWAY_TOKEN_URL=
FILE_GATEWAY_APPLICATION_ID=
FILE_GATEWAY_CLIENT_ID=
FILE_GATEWAY_CLIENT_SECRET=
FILE_GATEWAY_SCOPE=platform:file:upload

# 结算系统读取接入口令（SETTLEMENT_MACHINE_ENABLED=false 时无需填写；
# 启用时强制 REQUIRE_BEARER=true 与 CLIENT_ID/AUDIENCE）
SETTLEMENT_MACHINE_ENABLED=false
SETTLEMENT_MACHINE_REQUIRE_BEARER=false
SETTLEMENT_MACHINE_CLIENT_ID=
SETTLEMENT_MACHINE_AUDIENCE=

# 看板机器接入补全键（DASHBOARD_MACHINE_ENABLED=false 时无需填写）
DASHBOARD_MACHINE_ISSUER=
DASHBOARD_MACHINE_PUBLIC_KEY_PATH=
DASHBOARD_MACHINE_REQUIRED_SCOPE=
DASHBOARD_MACHINE_CALLER_APPLICATION_CODE=
DASHBOARD_MACHINE_CALLER_ENVIRONMENT_CODE=

# 项目管理审批机器接入（PROJECT_APPROVAL_MACHINE_ENABLED=false 时无需填写；
# 启用时强制 REQUIRE_BEARER=true 与下列全套键）
PROJECT_APPROVAL_MACHINE_ENABLED=false
PROJECT_APPROVAL_MACHINE_REQUIRE_BEARER=false
PROJECT_APPROVAL_MACHINE_CLIENT_ID=
PROJECT_APPROVAL_MACHINE_AUDIENCE=
PROJECT_APPROVAL_MACHINE_ISSUER=
PROJECT_APPROVAL_MACHINE_PUBLIC_KEY_PATH=
PROJECT_APPROVAL_MACHINE_REQUIRED_SCOPE=
PROJECT_APPROVAL_MACHINE_CALLER_APPLICATION_CODE=
PROJECT_APPROVAL_MACHINE_CALLER_ENVIRONMENT_CODE=

# OIDC IdP 提示（可选）
OIDC_IDP_HINT=

# Temporal 高级/版本化配置（留空即代码默认：metrics :9091、build contract-worker-v1、
# deployment contract-management、policy PINNED、versioning false）
TEMPORAL_API_KEY=
TEMPORAL_METRICS_ADDRESS=
TEMPORAL_WORKER_VERSIONING_ENABLED=
TEMPORAL_WORKER_VERSIONING_POLICY=
TEMPORAL_WORKER_BUILD_ID=
TEMPORAL_WORKER_DEPLOYMENT_NAME=
TEMPORAL_WORKER_ROLLOUT_ACTION=
TEMPORAL_WORKER_ROLLOUT_IDENTITY=

# --- 签署人手机号列加密密钥（SEC-D7，必填）：Base64 解码恰好 32 字节 ---
# 生成：openssl rand -base64 32
# 缺配后果（失败关闭）：/readyz 返回 not_ready，签署寄送写入被拒绝。
SIGNING_PHONE_ENCRYPTION_KEY_BASE64=

# --- 写请求附加允许源（SEC-D11，可选，逗号分隔的完整 origin） ---
# 主允许源始终取 APP_PUBLIC_URL 的 scheme://host；vite dev（http://localhost:5173）
# 直连后端时需在此补充该源，否则其写请求会被同源中间件失败关闭拒绝。
# 本地示例：APP_CORS_ALLOWED_ORIGINS=http://localhost:5173（vite dev 直连后端写接口时设置）；
# 经门户网关或生产模式访问无需设置（网关同源、主允许源已覆盖），勿把 dev 源带入生产。
APP_CORS_ALLOWED_ORIGINS=

