# GitHub test Environment 配置输入。
# 复制为 test.env 后填写本机文件绝对路径；test.env 已被 .gitignore 忽略。

GITHUB_REPOSITORY=J-S-Te/contract_management
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/opt/basic-platform

# 这里只保存文件路径，绝不能把 SSH 私钥内容写入本文件。
DEPLOY_SSH_KEY_FILE=/absolute/path/to/contract-management-deploy-ed25519
DEPLOY_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
